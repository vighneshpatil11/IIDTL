# ==============================================================================
# DOCFORTRESS / IIDTL - PRODUCTION ENVIRONMENT VARIABLES (TEMPLATE)
# WARNING: NEVER COMMIT ACTUAL PRODUCTION SECRETS TO VERSION CONTROL!
# ==============================================================================

# 1. JWT Authentication Signing Key (Random 32-byte secret hex or high-entropy string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=<REPLACE_WITH_SECURE_32_BYTE_HEX_JWT_SECRET>

# 2. Owner Forensic Vault Key (64-character / 32-byte HEX string for AES-256-GCM)
# Encrypts the mapping between invisible watermark IDs and recipient identities.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FORENSIC_MASTER_KEY_HEX=<REPLACE_WITH_SECURE_64_CHAR_HEX_KEY>

# 3. Environment configuration (production | development | testing)
ENVIRONMENT=production

# 4. Optional: Database Connection URL (e.g. Neon PostgreSQL or leave blank for local SQLite)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 5. Optional: Owner Registration Token (Only required if ALLOW_OWNER_REGISTRATION=true)
# OWNER_REGISTRATION_TOKEN=<REPLACE_WITH_STRONG_RANDOM_OWNER_REGISTRATION_TOKEN>

# 6. Master Owner Password (required for seeding the predefined owner account)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
OWNER_PASSWORD=<REPLACE_WITH_STRONG_RANDOM_OWNER_PASSWORD>
OWNER_EMAIL=admin@yourdomain.internal
OWNER_NAME=Master Document Owner
